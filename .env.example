# Copy to .env for local development without Docker.
DATABASE_URL=postgresql+psycopg://school:school@127.0.0.1:5463/school
TEST_DATABASE_URL=postgresql+psycopg://school:school@127.0.0.1:5463/school_test
SECRET_KEY=change-me
BASE_URL=http://127.0.0.1:4433
SCHOOL_NAME=Willow Brook Nursery and School
SCHOOL_TIMEZONE=Europe/London
SEED_DEMO=true
SHOW_DEMO_LOGINS=true
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM=Willow Brook <office@example.com>
UPLOAD_DIR=./uploads
MAX_UPLOAD_MB=8
SESSION_MAX_HOURS=12
SESSION_COOKIE_SECURE=false
LOGIN_MAX_FAILURES=5
LOGIN_WINDOW_MINUTES=15
